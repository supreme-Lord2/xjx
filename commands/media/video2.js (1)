const yts = require('yt-search');
const APIs = require('../../utils/api');

const fetchAudio = async (videoUrl) => {
    const result = await APIs.getKeithAudioByUrl(videoUrl);
    if (result && result.download) return result;
    throw new Error('audio: no download URL returned');
};

const fetchVideo = async (videoUrl) => {
    const result = await APIs.getKeithVideoByUrl(videoUrl);
    if (result && result.download) return result;
    throw new Error('video: no download URL returned');
};

// Tries each source link until one sends successfully. Returns true on success.
const sendWithFallback = async (sock, chatId, msg, sources, buildContent) => {
    for (const src of sources) {
        try {
            await sock.sendMessage(chatId, buildContent(src), { quoted: msg });
            return true;
        } catch (e) {
            continue;
        }
    }
    return false;
};

module.exports = {
    name: 'video2',
    aliases: ['ytboth', 'mp3mp4'],
    category: 'media',
    description: 'Download both MP3 and MP4 from YouTube',
    usage: '.video2 <video name or URL>',

    async execute(sock, msg, args, extra) {
        try {
            const chatId = extra.from;
            const searchQuery = args.join(' ').trim();

            if (!searchQuery) {
                return await sock.sendMessage(chatId, {
                    text: '📥 Please provide a video name or YouTube URL.'
                }, { quoted: msg });
            }

            await sock.sendMessage(chatId, {
                react: { text: '📥', key: msg.key }
            });

            const isUrl = searchQuery.startsWith('http://') || searchQuery.startsWith('https://');
            let videoUrl = searchQuery;
            let title = null;

            // --- Metadata extraction (yts, best-effort) ---
            if (!isUrl) {
                const { videos } = await yts(searchQuery);
                if (!videos || videos.length === 0) {
                    return await sock.sendMessage(chatId, {
                        text: '❌ No videos found for that search.'
                    }, { quoted: msg });
                }
                const found = videos[0];
                videoUrl = found.url;
                title = found.title;
            } else {
                try {
                    const ytId = APIs.extractYouTubeId(videoUrl);
                    if (ytId) {
                        const result = await yts({ videoId: ytId });
                        if (result && result.title) {
                            title = result.title;
                        }
                    }
                } catch (e) {}
            }

            // --- Fetch MP3 + MP4 links in parallel ---
            const [audioRes, videoRes] = await Promise.allSettled([
                fetchAudio(videoUrl),
                fetchVideo(videoUrl)
            ]);

            const audioData = audioRes.status === 'fulfilled' ? audioRes.value : null;
            const videoData = videoRes.status === 'fulfilled' ? videoRes.value : null;

            if (!audioData && !videoData) {
                return await sock.sendMessage(chatId, {
                    text: '❌ Failed to fetch audio and video. Please try again later.'
                }, { quoted: msg });
            }

            const finalTitle = title || videoData?.title || audioData?.title || 'Unknown Title';
            const safeTitle = finalTitle.replace(/[^\w\s\-()]/g, '').trim() || 'media';

            await sock.sendMessage(chatId, { text: `_${finalTitle}_` });

            const failed = [];

            // --- Send MP4 (inline video, document fallback) ---
            if (videoData) {
                const vSources = [...new Set([videoData.download, videoData.fallback].filter(Boolean))];

                let ok = await sendWithFallback(sock, chatId, msg, vSources, (src) => ({
                    video: { url: src },
                    mimetype: 'video/mp4',
                    fileName: `${safeTitle}.mp4`,
                    caption: `_${finalTitle}_`
                }));

                if (!ok) {
                    ok = await sendWithFallback(sock, chatId, msg, vSources, (src) => ({
                        document: { url: src },
                        mimetype: 'video/mp4',
                        fileName: `${safeTitle}.mp4`
                    }));
                }

                if (!ok) failed.push('video');
            } else {
                failed.push('video');
            }

            // --- Send MP3 (playable audio) ---
            if (audioData) {
                const aSources = [...new Set([audioData.download, audioData.fallback].filter(Boolean))];

                const ok = await sendWithFallback(sock, chatId, msg, aSources, (src) => ({
                    audio: { url: src },
                    mimetype: 'audio/mpeg',
                    fileName: `${safeTitle}.mp3`,
                    ptt: false
                }));

                if (!ok) failed.push('audio');
            } else {
                failed.push('audio');
            }

            if (failed.length) {
                await sock.sendMessage(chatId, {
                    text: `⚠️ Could not send: ${failed.join(' & ')}.`
                }, { quoted: msg });
            }

        } catch (error) {
            console.error('Error in video2 command:', error);
            await sock.sendMessage(msg.key.remoteJid, {
                text: '❌ Download failed. Please try again later.'
            }, { quoted: msg });
        }
    }
};
